{
  "realm": "srm-credit",
  "enabled": true,
  "displayName": "SRM Credit Engine",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 30,
  "minimumQuickLoginWaitSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "quickLoginCheckMilliSeconds": 1000,
  "passwordPolicy": "length(12) and lowerCase(1) and upperCase(1) and digits(1)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "clients": [
    {
      "clientId": "ui-r-credit",
      "name": "SRM Credit Engine UI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "${KEYCLOAK_FRONTEND_URL}/"
      ],
      "webOrigins": [
        "${KEYCLOAK_FRONTEND_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${KEYCLOAK_FRONTEND_URL}/"
      },
      "protocolMappers": [
        {
          "name": "spe-j-engine audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "spe-j-engine",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "spe-j-engine",
      "name": "SRM Credit Engine API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "OPERADOR",
        "description": "Acessa as operações autorizadas do engine."
      },
      {
        "name": "GESTOR",
        "description": "Consulta e decide propostas cambiais."
      }
    ]
  },
  "users": [
    {
      "username": "operador",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Operador",
      "lastName": "Demonstração",
      "email": "operador@srm-credit.local",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_OPERATOR_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "OPERADOR"
      ]
    },
    {
      "username": "gestor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Gestor",
      "lastName": "Demonstração",
      "email": "gestor@srm-credit.local",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_MANAGER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "GESTOR"
      ]
    }
  ]
}
